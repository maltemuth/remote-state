{
  "name": "remote-state-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "TypeScript-based multiplayer game infrastructure library",
  "license": "MIT",
  "author": "Malte Muth",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "workspaces": [
    "packages/remote-state",
    "packages/remote-state-example-server"
  ],
  "scripts": {
    "build": "npm run build --workspaces",
    "test": "npm test --workspaces",
    "lint": "npm run lint --workspaces",
    "start:example": "npm run build && npm start --workspace packages/remote-state-example-server"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@typescript-eslint/eslint-plugin": "^8.71.0",
    "@typescript-eslint/parser": "^8.71.0",
    "eslint": "^10.11.0",
    "jiti": "^2.7.0",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "@parcel/watcher": false,
    "unrs-resolver": false
  }
}
