{
  "compilerOptions": {
    // Node 24 supports ES2024
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,

    // Decorators (sequelize-typescript). No emitDecoratorMetadata: under ESM its
    // eager class references crash on the Game <-> Player import cycle.
    "experimentalDecorators": true,

    "declaration": true,
    "skipLibCheck": true,
    // Each file must compile on its own; ts-jest transpiles files in isolation
    "isolatedModules": true,

    // TypeScript 6 enables strict by default; the library is not strict-clean yet
    "strict": false
  },

  "exclude": ["node_modules", "dist"]
}
