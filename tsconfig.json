{
  "compilerOptions": {
    // Node 24 supports ES2024
    "target": "es2024",
    "lib": ["es2024"],
    "types": ["node"],

    "module": "nodenext",
    "moduleResolution": "nodenext",
    "esModuleInterop": true,

    // Standard (TC39) decorators need no flags; entity property types are given
    // explicitly, so no decorator metadata is needed either

    "declaration": true,
    "skipLibCheck": true,
    // Each file must compile on its own; ts-jest transpiles files in isolation
    "isolatedModules": true,

    // TypeScript 6 enables strict by default; the library is not strict-clean yet
    "strict": false
  },

  "exclude": ["node_modules", "dist"]
}
