{
  "name": "@malte.muth/remote-state-example-server",
  "version": "0.8.0",
  "private": true,
  "description": "Example server implementation using the Remote State library",
  "license": "MIT",
  "author": "Malte Muth",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "pretest": "npm run build --prefix ../remote-state && npm run build --prefix ../remote-state-client",
    "test": "npm run typecheck && NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src __test__",
    "lint:fix": "eslint src __test__ --fix",
    "format": "prettier --write src __test__",
    "format:check": "prettier --check src __test__",
    "clean": "rm -rf dist",
    "perf": "npm run build --prefix ../remote-state && npm run build && node dist/perf/run.js",
    "perf:profile": "npm run build && node dist/perf/profile.js"
  },
  "dependencies": {
    "@malte.muth/remote-state": "file:../remote-state",
    "@malte.muth/remote-state-client": "file:../remote-state-client",
    "express": "^5.2.1",
    "immer": "^11.1.21",
    "socket.io-client": "^4.8.4"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "supertest": "^7.3.0"
  }
}
