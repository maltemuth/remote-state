{
  "name": "@malte.muth/remote-state-example-server",
  "version": "0.1.0",
  "description": "Example server implementation using the Remote State library",
  "license": "MIT",
  "author": "Malte Muth",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node dist/server.js",
    "build": "tsc",
    "pretest": "npm run build --prefix ../remote-state",
    "test": "npm run typecheck && NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "format": "prettier --write src",
    "format:check": "prettier --check src",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@malte.muth/remote-state": "file:../remote-state",
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
