{
  "name": "@malte.muth/remote-state",
  "version": "0.1.0",
  "description": "TypeScript-based multiplayer game infrastructure library",
  "license": "MIT",
  "author": "Malte Muth",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc",
    "test": "npm run typecheck && NODE_OPTIONS=--experimental-vm-modules jest",
    "typecheck": "tsc -p tsconfig.test.json",
    "test:integration": "NODE_OPTIONS=--experimental-vm-modules jest --testMatch='**/__test__/integration/**/*.test.ts'",
    "test:watch": "NODE_OPTIONS=--experimental-vm-modules jest --watch",
    "lint": "eslint src __test__",
    "lint:fix": "eslint src __test__ --fix",
    "format": "prettier --write src __test__",
    "format:check": "prettier --check src __test__",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.2",
    "@mikro-orm/decorators": "^7.2.2",
    "@mikro-orm/migrations": "^7.2.2",
    "@mikro-orm/sqlite": "^7.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@jest/globals": "^30.5.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.19.0",
    "@types/supertest": "^7.2.1",
    "jest": "^30.5.2",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.3.0",
    "ts-jest": "^29.4.14",
    "typescript": "^6.0.3"
  }
}
