  "description": "TypeScript-based multiplayer game infrastructure library",
  "license": "MIT",
  "author": "Malte Muth",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "start": "node dist/server.js",
    "dev": "ts-node src/server.ts",
