{
  "name": "@malte.muth/remote-state",
  "version": "0.9.1",
  "description": "TypeScript-based multiplayer game infrastructure library",
  "license": "MIT",
  "author": "Malte Muth",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maltemuth/remote-state.git",
    "directory": "packages/remote-state"
  },
  "homepage": "https://github.com/maltemuth/remote-state/tree/master/packages/remote-state#readme",
  "bugs": {
    "url": "https://github.com/maltemuth/remote-state/issues"
  },
  "keywords": [
    "multiplayer",
    "game",
    "server-authoritative",
    "state",
    "socket.io",
    "express",
    "immer",
    "patches",
    "hidden-information"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "npm run clean && tsc",
    "test": "npm run typecheck && node --import tsx --test \"__test__/**/*.test.ts\"",
    "typecheck": "tsc -p tsconfig.test.json",
    "lint": "eslint src __test__",
    "lint:fix": "eslint src __test__ --fix",
    "format": "prettier --write src __test__",
    "format:check": "prettier --check src __test__",
    "clean": "rm -rf dist",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@mikro-orm/core": "^7.2.2",
    "@mikro-orm/decorators": "^7.2.2",
    "@mikro-orm/sqlite": "^7.2.2",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "rfc6902": "^5.3.0",
    "socket.io": "^4.8.4"
  },
  "devDependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/supertest": "^7.2.1",
    "fast-check": "^4.10.2",
    "immer": "^11.1.21",
    "socket.io-client": "^4.8.4",
    "socket.io-msgpack-parser": "^3.0.2",
    "supertest": "^7.3.0"
  }
}
