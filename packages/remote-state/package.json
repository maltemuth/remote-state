{
  "name": "@malte.muth/remote-state",
  "version": "0.1.0",
  "description": "TypeScript-based multiplayer game infrastructure library",
  "license": "MIT",
  "author": "Malte Muth",
  "type": "commonjs",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "test": "jest",
    "test:integration": "jest --testMatch='**/__test__/integration/**/*.test.ts'",
    "test:e2e": "jest --testMatch='**/__test__/e2e/**/*.test.ts'",
    "test:watch": "jest --watch",
    "lint": "eslint src __test__",
    "lint:fix": "eslint src __test__ --fix",
    "format": "prettier --write src __test__",
    "format:check": "prettier --check src __test__",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "express": "^5",
    "sequelize": "^6.37.3",
    "sequelize-typescript": "^2.1.6",
    "socket.io": "^4.7.5",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "zod": "^4.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.34.0",
    "@types/cors": "^2.8.13",
    "@types/express": "^5",
    "@types/jest": "^30.0.0",
    "@types/node": "^24",
    "@typescript-eslint/eslint-plugin": "^8.40.0",
    "@typescript-eslint/parser": "^8.40.0",
    "eslint": "^9.34.0",
    "jest": "^30.1.0",
    "jiti": "^2.5.1",
    "prettier": "^3.0.0",
    "socket.io-client": "^4.8.4",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.1",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0"
  }
}
