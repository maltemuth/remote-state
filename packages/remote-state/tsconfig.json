{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "./dist",
    "skipLibCheck": true,
    "module": "commonjs"
  },

  // Include only the source directory
  "include": ["src/**/*"],

  // Exclude test files from build
  "exclude": ["node_modules", "dist", "**/*.test.ts", "**/*.spec.ts"]
}
